[
 {
  "i": 1,
  "start": 0.0,
  "end": 2.0,
  "text": "أهلًا بكم في شرح جديد.",
  "sign": null
 },
 {
  "i": 2,
  "start": 2.0,
  "end": 6.0,
  "text": "عن أخطر ما وصلت إليه جرائم الأمن الرقمي.",
  "sign": null
 },
 {
  "i": 3,
  "start": 6.0,
  "end": 8.0,
  "text": "التهديدات السيبرانية المتقدمة.",
  "sign": "التهديدات"
 },
 {
  "i": 4,
  "start": 8.0,
  "end": 11.0,
  "text": "لم تعد تقتصر على اختراق الأنظمة والبرامج.",
  "sign": null
 },
 {
  "i": 5,
  "start": 11.0,
  "end": 14.0,
  "text": "بل أصبحت تستهدف شيئًا أكثر تعقيدًا:",
  "sign": null
 },
 {
  "i": 6,
  "start": 14.0,
  "end": 16.0,
  "text": "النفسية البشرية نفسها.",
  "sign": null
 },
 {
  "i": 7,
  "start": 16.0,
  "end": 19.13,
  "text": "تخيّل صورة المخترق بقبعة سوداء في غرفة مظلمة.",
  "sign": null
 },
 {
  "i": 8,
  "start": 19.13,
  "end": 22.13,
  "text": "يكتب أسطر كود بسرعة كما نرى في الأفلام.",
  "sign": null
 },
 {
  "i": 9,
  "start": 22.13,
  "end": 23.13,
  "text": "هذه الصورة غير حقيقية.",
  "sign": null
 },
 {
  "i": 10,
  "start": 23.13,
  "end": 25.13,
  "text": "الأمن السيبراني المتقدم",
  "sign": null
 },
 {
  "i": 11,
  "start": 25.13,
  "end": 28.13,
  "text": "لم يعد مجرد كسر لكلمات المرور.",
  "sign": null
 },
 {
  "i": 12,
  "start": 28.13,
  "end": 32.13,
  "text": "الحقيقة أن المهاجم يمارس فن اختراق العقول.",
  "sign": null
 },
 {
  "i": 13,
  "start": 32.13,
  "end": 35.13,
  "text": "التهديدات الحديثة والأكثر خطورة",
  "sign": null
 },
 {
  "i": 14,
  "start": 35.13,
  "end": 38.13,
  "text": "تستغل مشاعر إنسانية موجودة فينا جميعًا.",
  "sign": null
 },
 {
  "i": 15,
  "start": 38.13,
  "end": 41.26,
  "text": "مثل الثقة والخوف والفضول.",
  "sign": null
 },
 {
  "i": 16,
  "start": 41.26,
  "end": 43.26,
  "text": "خريطة طريقنا سريعة وواضحة.",
  "sign": null
 },
 {
  "i": 17,
  "start": 43.26,
  "end": 46.26,
  "text": "نبدأ باختراق العقول لا الأجهزة.",
  "sign": null
 },
 {
  "i": 18,
  "start": 46.26,
  "end": 48.26,
  "text": "ثم برامج الفدية.",
  "sign": "الفدية"
 },
 {
  "i": 19,
  "start": 48.26,
  "end": 50.26,
  "text": "ثم سيكولوجية الهندسة الاجتماعية.",
  "sign": "الخداع"
 },
 {
  "i": 20,
  "start": 50.26,
  "end": 52.26,
  "text": "ثم إرهاق الأنظمة بهجمات DDoS.",
  "sign": "الإغراق"
 },
 {
  "i": 21,
  "start": 52.26,
  "end": 56.26,
  "text": "وأخيرًا الدفاع الأخلاقي والمتاح للجميع.",
  "sign": "الأمان"
 },
 {
  "i": 22,
  "start": 56.26,
  "end": 58.35,
  "text": "نبدأ بالنقطة الأولى.",
  "sign": null
 },
 {
  "i": 23,
  "start": 58.35,
  "end": 60.35,
  "text": "اختراق العقول لا الأجهزة.",
  "sign": null
 },
 {
  "i": 24,
  "start": 60.35,
  "end": 62.35,
  "text": "لو قارنّا بين الأمرين:",
  "sign": null
 },
 {
  "i": 25,
  "start": 62.35,
  "end": 67.35,
  "text": "كان الاختراق التقليدي يعتمد على ثغرة صغيرة في جدار الحماية.",
  "sign": null
 },
 {
  "i": 26,
  "start": 67.35,
  "end": 69.35,
  "text": "أو خطأ في سطر برمجي.",
  "sign": null
 },
 {
  "i": 27,
  "start": 69.35,
  "end": 72.35,
  "text": "لكن المهاجمين اكتشفوا أن اختراق العقل البشري",
  "sign": null
 },
 {
  "i": 28,
  "start": 72.35,
  "end": 75.35,
  "text": "أسهل وأسرع بكثير من كسر جدار رقمي.",
  "sign": null
 },
 {
  "i": 29,
  "start": 75.35,
  "end": 77.35,
  "text": "فلماذا يتعبون أنفسهم؟",
  "sign": null
 },
 {
  "i": 30,
  "start": 77.35,
  "end": 80.35,
  "text": "الهندسة الاجتماعية تستهدف ثغراتنا النفسية.",
  "sign": null
 },
 {
  "i": 31,
  "start": 80.35,
  "end": 85.15,
  "text": "المهاجم لا يحتاج كودًا معقدًا إذا استطاع بحيلة نفسية بسيطة",
  "sign": null
 },
 {
  "i": 32,
  "start": 85.15,
  "end": 90.15,
  "text": "أن يقنع أيًّا منا أن يسلّمه بياناته السرية بنفسه وبرضاه.",
  "sign": null
 },
 {
  "i": 33,
  "start": 90.15,
  "end": 95.42,
  "text": "النقطة الثانية: برامج الفدية، أو ما نسميه الرهائن الرقمية.",
  "sign": null
 },
 {
  "i": 34,
  "start": 95.42,
  "end": 99.01,
  "text": "تخيّل كابوسًا رقميًا يحدث في لحظة.",
  "sign": null
 },
 {
  "i": 35,
  "start": 99.01,
  "end": 100.81,
  "text": "شاشة الجهاز تُقفل بالكامل.",
  "sign": null
 },
 {
  "i": 36,
  "start": 100.81,
  "end": 103.61,
  "text": "وتظهر رسالة واضحة تطلب فدية مالية.",
  "sign": null
 },
 {
  "i": 37,
  "start": 103.61,
  "end": 106.41,
  "text": "حتى يعود النظام للعمل وتُفتح الملفات.",
  "sign": null
 },
 {
  "i": 38,
  "start": 106.41,
  "end": 109.41,
  "text": "النقطة الجوهرية هنا ليست التشفير التقني.",
  "sign": null
 },
 {
  "i": 39,
  "start": 109.41,
  "end": 112.21,
  "text": "بل اللعبة على سيكولوجية الخوف.",
  "sign": null
 },
 {
  "i": 40,
  "start": 112.21,
  "end": 115.77,
  "text": "الهدف خلق حالة رعب وضغط نفسي سريع.",
  "sign": null
 },
 {
  "i": 41,
  "start": 115.77,
  "end": 119.49,
  "text": "حين يخاف الإنسان يرتفع هرمون التوتر مثل الكورتيزول.",
  "sign": null
 },
 {
  "i": 42,
  "start": 119.49,
  "end": 121.77,
  "text": "وهذا يعطّل التفكير المنطقي تمامًا.",
  "sign": null
 },
 {
  "i": 43,
  "start": 121.77,
  "end": 124.85,
  "text": "ويجعل الضحية تتخذ قرارًا متسرعًا وغير عقلاني.",
  "sign": null
 },
 {
  "i": 44,
  "start": 124.85,
  "end": 127.41,
  "text": "بالدفع فورًا لإنقاذ ملفاتها المهمة.",
  "sign": null
 },
 {
  "i": 45,
  "start": 127.41,
  "end": 131.25,
  "text": "لاحظ كيف يتفوق العامل النفسي على أي تدريب تقني.",
  "sign": null
 },
 {
  "i": 46,
  "start": 131.25,
  "end": 134.32,
  "text": "نصل إلى القسم الثالث المهم جدًا.",
  "sign": null
 },
 {
  "i": 47,
  "start": 134.32,
  "end": 136.6,
  "text": "سيكولوجية الهندسة الاجتماعية.",
  "sign": null
 },
 {
  "i": 48,
  "start": 136.6,
  "end": 143.5,
  "text": "اللعبة كلها على العقول، وتحديدًا ثلاث أساليب رئيسية تتجاوز حذرنا الطبيعي.",
  "sign": null
 },
 {
  "i": 49,
  "start": 143.5,
  "end": 149.35,
  "text": "أولًا: التصيد الموجه (Spear Phishing)، ويستهدف الثقة والمألوفية.",
  "sign": "التصيد"
 },
 {
  "i": 50,
  "start": 149.35,
  "end": 156.43,
  "text": "يجمع المهاجم بيانات دقيقة من وسائل التواصل لتبدو رسالته من جهة نثق بها.",
  "sign": null
 },
 {
  "i": 51,
  "start": 156.43,
  "end": 160.35,
  "text": "ثانيًا: انتحال الشخصية، ويستغل سلطة المنصب.",
  "sign": "الانتحال"
 },
 {
  "i": 52,
  "start": 160.35,
  "end": 166.51,
  "text": "ينتحل المهاجم صفة مسؤول بنكي أو مدير ليدفع الضحية للاستجابة السريعة.",
  "sign": null
 },
 {
  "i": 53,
  "start": 166.51,
  "end": 168.07,
  "text": "استجابةً للضغط.",
  "sign": null
 },
 {
  "i": 54,
  "start": 168.07,
  "end": 169.95,
  "text": "ثالثًا: الاستدراج.",
  "sign": "الإغراء"
 },
 {
  "i": 55,
  "start": 169.95,
  "end": 172.35,
  "text": "ويستغل أكثر ما فينا: الفضول.",
  "sign": null
 },
 {
  "i": 56,
  "start": 172.35,
  "end": 174.35,
  "text": "عرض مغري أو ملف مجاني.",
  "sign": null
 },
 {
  "i": 57,
  "start": 174.35,
  "end": 177.71,
  "text": "هذه الأشياء تفرز الدوبامين في المخ.",
  "sign": null
 },
 {
  "i": 58,
  "start": 177.71,
  "end": 180.23,
  "text": "فيجعلنا نتجاهل التحذيرات الأمنية.",
  "sign": null
 },
 {
  "i": 59,
  "start": 180.23,
  "end": 182.15,
  "text": "ونضغط على الرابط فورًا.",
  "sign": null
 },
 {
  "i": 60,
  "start": 182.15,
  "end": 184.39,
  "text": "كل أسلوب منها مصمم بدقة",
  "sign": null
 },
 {
  "i": 61,
  "start": 184.39,
  "end": 185.83,
  "text": "لتجاوز المنطق.",
  "sign": null
 },
 {
  "i": 62,
  "start": 185.83,
  "end": 188.5,
  "text": "وإحداث استجابة نفسية تلقائية.",
  "sign": null
 },
 {
  "i": 63,
  "start": 188.5,
  "end": 190.02,
  "text": "ننتقل إلى القسم الرابع.",
  "sign": null
 },
 {
  "i": 64,
  "start": 190.02,
  "end": 193.64,
  "text": "إرهاق الأنظمة بهجمات DDoS.",
  "sign": null
 },
 {
  "i": 65,
  "start": 193.64,
  "end": 199.32,
  "text": "في هجمات الحرمان من الخدمة الموزعة، المشكلة ليست اختراقًا معقدًا.",
  "sign": null
 },
 {
  "i": 66,
  "start": 199.32,
  "end": 203.72,
  "text": "بل القوة الغاشمة: آلاف الأجهزة المخترقة",
  "sign": null
 },
 {
  "i": 67,
  "start": 203.72,
  "end": 208.52,
  "text": "تهاجم معًا في وقت واحد لترسل سيلًا من الطلبات إلى خادم واحد.",
  "sign": "الخادم"
 },
 {
  "i": 68,
  "start": 208.52,
  "end": 212.28,
  "text": "النتيجة: إرهاق الخادم وخروجه عن الخدمة تمامًا.",
  "sign": null
 },
 {
  "i": 69,
  "start": 212.28,
  "end": 218.52,
  "text": "الهدف استهداف البنية التحتية، وهو تهديد يطال شركات ومؤسسات كاملة.",
  "sign": null
 },
 {
  "i": 70,
  "start": 218.52,
  "end": 222.12,
  "text": "بمجرد أن يعجز الخادم عن معالجة الكم الهائل من البيانات",
  "sign": null
 },
 {
  "i": 71,
  "start": 222.12,
  "end": 223.92,
  "text": "التي تصل في اللحظة نفسها.",
  "sign": null
 },
 {
  "i": 72,
  "start": 223.92,
  "end": 226.15,
  "text": "القسم الخامس والأخير.",
  "sign": null
 },
 {
  "i": 73,
  "start": 226.15,
  "end": 228.35,
  "text": "الدفاع الأخلاقي والمتاح.",
  "sign": null
 },
 {
  "i": 74,
  "start": 228.35,
  "end": 230.22,
  "text": "كيف نحمي أنفسنا؟",
  "sign": null
 },
 {
  "i": 75,
  "start": 230.22,
  "end": 234.02,
  "text": "الدفاع الحقيقي يبدأ بشيء نسميه «الشك الصحي».",
  "sign": null
 },
 {
  "i": 76,
  "start": 234.02,
  "end": 237.22,
  "text": "لازم نتحقق دائمًا من أي مصدر يطلب معلوماتنا.",
  "sign": "التحقق"
 },
 {
  "i": 77,
  "start": 237.22,
  "end": 239.22,
  "text": "مهما بدا مألوفًا.",
  "sign": null
 },
 {
  "i": 78,
  "start": 239.22,
  "end": 240.62,
  "text": "والأهم من ذلك:",
  "sign": null
 },
 {
  "i": 79,
  "start": 240.62,
  "end": 243.22,
  "text": "المصدر يؤكد نقطة في غاية الأهمية.",
  "sign": null
 },
 {
  "i": 80,
  "start": 243.22,
  "end": 244.62,
  "text": "وهي الإتاحة.",
  "sign": "الإتاحة"
 },
 {
  "i": 81,
  "start": 244.62,
  "end": 247.02,
  "text": "حتى تكون البيئة الرقمية آمنة للجميع.",
  "sign": null
 },
 {
  "i": 82,
  "start": 247.02,
  "end": 250.18,
  "text": "بمن فيهم من لديهم إعاقات بصرية أو سمعية.",
  "sign": null
 },
 {
  "i": 83,
  "start": 250.18,
  "end": 252.38,
  "text": "التصميم الأمني لازم يكون شاملًا.",
  "sign": null
 },
 {
  "i": 84,
  "start": 252.38,
  "end": 253.42,
  "text": "يعني مثلًا:",
  "sign": null
 },
 {
  "i": 85,
  "start": 253.42,
  "end": 255.1,
  "text": "التحذير من رسالة مشبوهة.",
  "sign": null
 },
 {
  "i": 86,
  "start": 255.1,
  "end": 257.46,
  "text": "لا يصح أن يعتمد على اللون الأحمر وحده.",
  "sign": null
 },
 {
  "i": 87,
  "start": 257.46,
  "end": 260.58,
  "text": "لأنه يستبعد من لديهم صعوبة في تمييز الألوان.",
  "sign": null
 },
 {
  "i": 88,
  "start": 260.58,
  "end": 264.45,
  "text": "لازم يكون فيه نص بديل واضح ومقروء يشرح الخطر.",
  "sign": null
 },
 {
  "i": 89,
  "start": 264.45,
  "end": 266.41,
  "text": "الأمن السيبراني الناجح حقًا",
  "sign": null
 },
 {
  "i": 90,
  "start": 266.41,
  "end": 268.53,
  "text": "هو الذي يحمي الجميع بلا استثناء.",
  "sign": null
 },
 {
  "i": 91,
  "start": 268.53,
  "end": 270.73,
  "text": "وبدون أي لوم للضحية.",
  "sign": null
 },
 {
  "i": 92,
  "start": 270.73,
  "end": 273.05,
  "text": "وهنا سؤال ختامي مهم جدًا.",
  "sign": null
 },
 {
  "i": 93,
  "start": 273.05,
  "end": 274.73,
  "text": "محتاجين كلنا نفكر فيه.",
  "sign": null
 },
 {
  "i": 94,
  "start": 274.73,
  "end": 278.33,
  "text": "إلى أي مدى تُعتبر بصمتنا الرقمية اليومية",
  "sign": null
 },
 {
  "i": 95,
  "start": 278.33,
  "end": 281.97,
  "text": "ومشاركتنا البسيطة على الإنترنت عرضة لهذه الحيل النفسية؟",
  "sign": null
 },
 {
  "i": 96,
  "start": 281.97,
  "end": 285.77,
  "text": "كل معلومة نشاركها قد تكون قطعة البازل الناقصة.",
  "sign": null
 },
 {
  "i": 97,
  "start": 285.77,
  "end": 289.73,
  "text": "التي يستخدمها المهاجم ليبني قصة مقنعة يخدعنا بها.",
  "sign": null
 },
 {
  "i": 98,
  "start": 289.73,
  "end": 292.17,
  "text": "فهم السيكولوجية وراء هذه التهديدات",
  "sign": null
 },
 {
  "i": 99,
  "start": 292.17,
  "end": 296.45,
  "text": "هو فعلًا أول وأهم خطوة لبناء درع واقعي يحمينا.",
  "sign": null
 },
 {
  "i": 100,
  "start": 296.45,
  "end": 298.21,
  "text": "قبل أن نحمي أجهزتنا.",
  "sign": null
 },
 {
  "i": 101,
  "start": 298.21,
  "end": 302.37,
  "text": "لنبقَ دائمًا يقظين ونطبّق هذا الوعي الرقمي.",
  "sign": "الوعي"
 }
]