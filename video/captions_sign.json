{
 "fps": 5,
 "chunks": [
  {
   "start": 0.0,
   "end": 2.0,
   "text": "أهلًا بكم في شرح جديد."
  },
  {
   "start": 2.0,
   "end": 4.634,
   "text": "عن أخطر ما وصلت إليه جرائم"
  },
  {
   "start": 4.634,
   "end": 6.0,
   "text": "الأمن الرقمي."
  },
  {
   "start": 6.0,
   "end": 7.355,
   "text": "التهديدات السيبرانية"
  },
  {
   "start": 7.355,
   "end": 9.714,
   "text": "المتقدمة. لم تعد تقتصر على اختراق"
  },
  {
   "start": 9.714,
   "end": 11.0,
   "text": "الأنظمة والبرامج."
  },
  {
   "start": 11.0,
   "end": 13.25,
   "text": "بل أصبحت تستهدف شيئًا أكثر"
  },
  {
   "start": 13.25,
   "end": 16.0,
   "text": "تعقيدًا: النفسية البشرية نفسها."
  },
  {
   "start": 16.0,
   "end": 17.701,
   "text": "تخيّل صورة المخترق بقبعة"
  },
  {
   "start": 17.701,
   "end": 19.13,
   "text": "سوداء في غرفة مظلمة."
  },
  {
   "start": 19.13,
   "end": 21.23,
   "text": "يكتب أسطر كود بسرعة كما نرى"
  },
  {
   "start": 21.23,
   "end": 23.13,
   "text": "في الأفلام. هذه الصورة غير حقيقية."
  },
  {
   "start": 23.13,
   "end": 25.13,
   "text": "الأمن السيبراني المتقدم"
  },
  {
   "start": 25.13,
   "end": 27.356,
   "text": "لم يعد مجرد كسر لكلمات"
  },
  {
   "start": 27.356,
   "end": 30.735,
   "text": "المرور. الحقيقة أن المهاجم يمارس فن"
  },
  {
   "start": 30.735,
   "end": 32.13,
   "text": "اختراق العقول."
  },
  {
   "start": 32.13,
   "end": 34.568,
   "text": "التهديدات الحديثة والأكثر"
  },
  {
   "start": 34.568,
   "end": 37.155,
   "text": "خطورة تستغل مشاعر إنسانية موجودة"
  },
  {
   "start": 37.155,
   "end": 41.26,
   "text": "فينا جميعًا. مثل الثقة والخوف والفضول."
  },
  {
   "start": 41.26,
   "end": 43.26,
   "text": "خريطة طريقنا سريعة وواضحة."
  },
  {
   "start": 43.26,
   "end": 45.416,
   "text": "نبدأ باختراق العقول لا"
  },
  {
   "start": 45.416,
   "end": 48.26,
   "text": "الأجهزة. ثم برامج الفدية."
  },
  {
   "start": 48.26,
   "end": 49.533,
   "text": "ثم سيكولوجية الهندسة"
  },
  {
   "start": 49.533,
   "end": 52.26,
   "text": "الاجتماعية. ثم إرهاق الأنظمة بهجمات DDoS."
  },
  {
   "start": 52.26,
   "end": 54.66,
   "text": "وأخيرًا الدفاع الأخلاقي"
  },
  {
   "start": 54.66,
   "end": 56.26,
   "text": "والمتاح للجميع."
  },
  {
   "start": 56.26,
   "end": 58.35,
   "text": "نبدأ بالنقطة الأولى."
  },
  {
   "start": 58.35,
   "end": 60.35,
   "text": "اختراق العقول لا الأجهزة."
  },
  {
   "start": 60.35,
   "end": 62.35,
   "text": "لو قارنّا بين الأمرين:"
  },
  {
   "start": 62.35,
   "end": 64.683,
   "text": "كان الاختراق التقليدي يعتمد"
  },
  {
   "start": 64.683,
   "end": 66.6,
   "text": "على ثغرة صغيرة في جدار"
  },
  {
   "start": 66.6,
   "end": 69.35,
   "text": "الحماية. أو خطأ في سطر برمجي."
  },
  {
   "start": 69.35,
   "end": 71.017,
   "text": "لكن المهاجمين اكتشفوا أن"
  },
  {
   "start": 71.017,
   "end": 72.35,
   "text": "اختراق العقل البشري"
  },
  {
   "start": 72.35,
   "end": 74.836,
   "text": "أسهل وأسرع بكثير من كسر جدار"
  },
  {
   "start": 74.836,
   "end": 77.35,
   "text": "رقمي. فلماذا يتعبون أنفسهم؟"
  },
  {
   "start": 77.35,
   "end": 79.164,
   "text": "الهندسة الاجتماعية تستهدف"
  },
  {
   "start": 79.164,
   "end": 80.35,
   "text": "ثغراتنا النفسية."
  },
  {
   "start": 80.35,
   "end": 82.791,
   "text": "المهاجم لا يحتاج كودًا معقدًا"
  },
  {
   "start": 82.791,
   "end": 85.15,
   "text": "إذا استطاع بحيلة نفسية بسيطة"
  },
  {
   "start": 85.15,
   "end": 87.606,
   "text": "أن يقنع أيًّا منا أن يسلّمه"
  },
  {
   "start": 87.606,
   "end": 90.15,
   "text": "بياناته السرية بنفسه وبرضاه."
  },
  {
   "start": 90.15,
   "end": 92.83,
   "text": "النقطة الثانية: برامج الفدية،"
  },
  {
   "start": 92.83,
   "end": 95.42,
   "text": "أو ما نسميه الرهائن الرقمية."
  },
  {
   "start": 95.42,
   "end": 98.395,
   "text": "تخيّل كابوسًا رقميًا يحدث في"
  },
  {
   "start": 98.395,
   "end": 100.81,
   "text": "لحظة. شاشة الجهاز تُقفل بالكامل."
  },
  {
   "start": 100.81,
   "end": 103.05,
   "text": "وتظهر رسالة واضحة تطلب فدية"
  },
  {
   "start": 103.05,
   "end": 105.747,
   "text": "مالية. حتى يعود النظام للعمل وتُفتح"
  },
  {
   "start": 105.747,
   "end": 108.239,
   "text": "الملفات. النقطة الجوهرية هنا ليست"
  },
  {
   "start": 108.239,
   "end": 109.41,
   "text": "التشفير التقني."
  },
  {
   "start": 109.41,
   "end": 111.578,
   "text": "بل اللعبة على سيكولوجية"
  },
  {
   "start": 111.578,
   "end": 115.16,
   "text": "الخوف. الهدف خلق حالة رعب وضغط نفسي"
  },
  {
   "start": 115.16,
   "end": 117.845,
   "text": "سريع. حين يخاف الإنسان يرتفع هرمون"
  },
  {
   "start": 117.845,
   "end": 119.49,
   "text": "التوتر مثل الكورتيزول."
  },
  {
   "start": 119.49,
   "end": 121.249,
   "text": "وهذا يعطّل التفكير المنطقي"
  },
  {
   "start": 121.249,
   "end": 123.444,
   "text": "تمامًا. ويجعل الضحية تتخذ قرارًا"
  },
  {
   "start": 123.444,
   "end": 124.85,
   "text": "متسرعًا وغير عقلاني."
  },
  {
   "start": 124.85,
   "end": 126.841,
   "text": "بالدفع فورًا لإنقاذ ملفاتها"
  },
  {
   "start": 126.841,
   "end": 129.73,
   "text": "المهمة. لاحظ كيف يتفوق العامل النفسي"
  },
  {
   "start": 129.73,
   "end": 131.25,
   "text": "على أي تدريب تقني."
  },
  {
   "start": 131.25,
   "end": 133.762,
   "text": "نصل إلى القسم الثالث المهم"
  },
  {
   "start": 133.762,
   "end": 136.6,
   "text": "جدًا. سيكولوجية الهندسة الاجتماعية."
  },
  {
   "start": 136.6,
   "end": 138.838,
   "text": "اللعبة كلها على العقول،"
  },
  {
   "start": 138.838,
   "end": 141.449,
   "text": "وتحديدًا ثلاث أساليب رئيسية"
  },
  {
   "start": 141.449,
   "end": 143.5,
   "text": "تتجاوز حذرنا الطبيعي."
  },
  {
   "start": 143.5,
   "end": 146.02,
   "text": "أولًا: التصيد الموجه (Spear"
  },
  {
   "start": 146.02,
   "end": 148.27,
   "text": "Phishing)، ويستهدف الثقة"
  },
  {
   "start": 148.27,
   "end": 152.202,
   "text": "والمألوفية. يجمع المهاجم بيانات دقيقة من"
  },
  {
   "start": 152.202,
   "end": 155.152,
   "text": "وسائل التواصل لتبدو رسالته من"
  },
  {
   "start": 155.152,
   "end": 156.43,
   "text": "جهة نثق بها."
  },
  {
   "start": 156.43,
   "end": 158.568,
   "text": "ثانيًا: انتحال الشخصية،"
  },
  {
   "start": 158.568,
   "end": 160.35,
   "text": "ويستغل سلطة المنصب."
  },
  {
   "start": 160.35,
   "end": 162.939,
   "text": "ينتحل المهاجم صفة مسؤول بنكي"
  },
  {
   "start": 162.939,
   "end": 164.814,
   "text": "أو مدير ليدفع الضحية"
  },
  {
   "start": 164.814,
   "end": 166.51,
   "text": "للاستجابة السريعة."
  },
  {
   "start": 166.51,
   "end": 168.07,
   "text": "استجابةً للضغط."
  },
  {
   "start": 168.07,
   "end": 169.95,
   "text": "ثالثًا: الاستدراج."
  },
  {
   "start": 169.95,
   "end": 172.35,
   "text": "ويستغل أكثر ما فينا: الفضول."
  },
  {
   "start": 172.35,
   "end": 174.35,
   "text": "عرض مغري أو ملف مجاني."
  },
  {
   "start": 174.35,
   "end": 177.15,
   "text": "هذه الأشياء تفرز الدوبامين في"
  },
  {
   "start": 177.15,
   "end": 179.563,
   "text": "المخ. فيجعلنا نتجاهل التحذيرات"
  },
  {
   "start": 179.563,
   "end": 182.15,
   "text": "الأمنية. ونضغط على الرابط فورًا."
  },
  {
   "start": 182.15,
   "end": 184.39,
   "text": "كل أسلوب منها مصمم بدقة"
  },
  {
   "start": 184.39,
   "end": 185.83,
   "text": "لتجاوز المنطق."
  },
  {
   "start": 185.83,
   "end": 188.5,
   "text": "وإحداث استجابة نفسية تلقائية."
  },
  {
   "start": 188.5,
   "end": 190.02,
   "text": "ننتقل إلى القسم الرابع."
  },
  {
   "start": 190.02,
   "end": 193.64,
   "text": "إرهاق الأنظمة بهجمات DDoS."
  },
  {
   "start": 193.64,
   "end": 195.964,
   "text": "في هجمات الحرمان من الخدمة"
  },
  {
   "start": 195.964,
   "end": 197.857,
   "text": "الموزعة، المشكلة ليست"
  },
  {
   "start": 197.857,
   "end": 199.32,
   "text": "اختراقًا معقدًا."
  },
  {
   "start": 199.32,
   "end": 201.85,
   "text": "بل القوة الغاشمة: آلاف"
  },
  {
   "start": 201.85,
   "end": 203.72,
   "text": "الأجهزة المخترقة"
  },
  {
   "start": 203.72,
   "end": 206.002,
   "text": "تهاجم معًا في وقت واحد لترسل"
  },
  {
   "start": 206.002,
   "end": 208.048,
   "text": "سيلًا من الطلبات إلى خادم"
  },
  {
   "start": 208.048,
   "end": 210.84,
   "text": "واحد. النتيجة: إرهاق الخادم وخروجه"
  },
  {
   "start": 210.84,
   "end": 212.28,
   "text": "عن الخدمة تمامًا."
  },
  {
   "start": 212.28,
   "end": 215.116,
   "text": "الهدف استهداف البنية التحتية،"
  },
  {
   "start": 215.116,
   "end": 217.858,
   "text": "وهو تهديد يطال شركات ومؤسسات"
  },
  {
   "start": 217.858,
   "end": 220.091,
   "text": "كاملة. بمجرد أن يعجز الخادم عن"
  },
  {
   "start": 220.091,
   "end": 221.531,
   "text": "معالجة الكم الهائل من"
  },
  {
   "start": 221.531,
   "end": 223.92,
   "text": "البيانات التي تصل في اللحظة نفسها."
  },
  {
   "start": 223.92,
   "end": 226.15,
   "text": "القسم الخامس والأخير."
  },
  {
   "start": 226.15,
   "end": 228.35,
   "text": "الدفاع الأخلاقي والمتاح."
  },
  {
   "start": 228.35,
   "end": 230.22,
   "text": "كيف نحمي أنفسنا؟"
  },
  {
   "start": 230.22,
   "end": 232.331,
   "text": "الدفاع الحقيقي يبدأ بشيء"
  },
  {
   "start": 232.331,
   "end": 234.02,
   "text": "نسميه «الشك الصحي»."
  },
  {
   "start": 234.02,
   "end": 236.082,
   "text": "لازم نتحقق دائمًا من أي مصدر"
  },
  {
   "start": 236.082,
   "end": 239.22,
   "text": "يطلب معلوماتنا. مهما بدا مألوفًا."
  },
  {
   "start": 239.22,
   "end": 240.62,
   "text": "والأهم من ذلك:"
  },
  {
   "start": 240.62,
   "end": 242.532,
   "text": "المصدر يؤكد نقطة في غاية"
  },
  {
   "start": 242.532,
   "end": 244.62,
   "text": "الأهمية. وهي الإتاحة."
  },
  {
   "start": 244.62,
   "end": 246.501,
   "text": "حتى تكون البيئة الرقمية آمنة"
  },
  {
   "start": 246.501,
   "end": 248.947,
   "text": "للجميع. بمن فيهم من لديهم إعاقات"
  },
  {
   "start": 248.947,
   "end": 250.18,
   "text": "بصرية أو سمعية."
  },
  {
   "start": 250.18,
   "end": 251.847,
   "text": "التصميم الأمني لازم يكون"
  },
  {
   "start": 251.847,
   "end": 253.42,
   "text": "شاملًا. يعني مثلًا:"
  },
  {
   "start": 253.42,
   "end": 255.1,
   "text": "التحذير من رسالة مشبوهة."
  },
  {
   "start": 255.1,
   "end": 256.673,
   "text": "لا يصح أن يعتمد على اللون"
  },
  {
   "start": 256.673,
   "end": 259.54,
   "text": "الأحمر وحده. لأنه يستبعد من لديهم صعوبة في"
  },
  {
   "start": 259.54,
   "end": 262.852,
   "text": "تمييز الألوان. لازم يكون فيه نص بديل واضح"
  },
  {
   "start": 262.852,
   "end": 264.45,
   "text": "ومقروء يشرح الخطر."
  },
  {
   "start": 264.45,
   "end": 266.41,
   "text": "الأمن السيبراني الناجح حقًا"
  },
  {
   "start": 266.41,
   "end": 267.952,
   "text": "هو الذي يحمي الجميع بلا"
  },
  {
   "start": 267.952,
   "end": 270.73,
   "text": "استثناء. وبدون أي لوم للضحية."
  },
  {
   "start": 270.73,
   "end": 273.05,
   "text": "وهنا سؤال ختامي مهم جدًا."
  },
  {
   "start": 273.05,
   "end": 274.73,
   "text": "محتاجين كلنا نفكر فيه."
  },
  {
   "start": 274.73,
   "end": 276.925,
   "text": "إلى أي مدى تُعتبر بصمتنا"
  },
  {
   "start": 276.925,
   "end": 278.33,
   "text": "الرقمية اليومية"
  },
  {
   "start": 278.33,
   "end": 279.76,
   "text": "ومشاركتنا البسيطة على"
  },
  {
   "start": 279.76,
   "end": 281.385,
   "text": "الإنترنت عرضة لهذه الحيل"
  },
  {
   "start": 281.385,
   "end": 284.072,
   "text": "النفسية؟ كل معلومة نشاركها قد تكون"
  },
  {
   "start": 284.072,
   "end": 285.77,
   "text": "قطعة البازل الناقصة."
  },
  {
   "start": 285.77,
   "end": 287.988,
   "text": "التي يستخدمها المهاجم ليبني"
  },
  {
   "start": 287.988,
   "end": 289.73,
   "text": "قصة مقنعة يخدعنا بها."
  },
  {
   "start": 289.73,
   "end": 291.473,
   "text": "فهم السيكولوجية وراء هذه"
  },
  {
   "start": 291.473,
   "end": 294.811,
   "text": "التهديدات هو فعلًا أول وأهم خطوة لبناء"
  },
  {
   "start": 294.811,
   "end": 296.45,
   "text": "درع واقعي يحمينا."
  },
  {
   "start": 296.45,
   "end": 298.21,
   "text": "قبل أن نحمي أجهزتنا."
  },
  {
   "start": 298.21,
   "end": 301.046,
   "text": "لنبقَ دائمًا يقظين ونطبّق هذا"
  },
  {
   "start": 301.046,
   "end": 302.37,
   "text": "الوعي الرقمي."
  }
 ]
}